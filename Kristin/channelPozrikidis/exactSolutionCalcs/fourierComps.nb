Cell[BoxData[
 RowBox[{
  RowBox[{"pExactAnon", "[", "x_", "]"}], " ", "=", " ", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "G"}], "*", "x"}], "+", "bL"}], ",", " ", 
       RowBox[{"x", "<", "c"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "G"}], "*", 
        RowBox[{
         RowBox[{"Sinh", "[", 
          RowBox[{"\[Eta]", "*", 
           RowBox[{"(", 
            RowBox[{"x", "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"L", "+", 
                RowBox[{"2", "*", "c"}]}], ")"}], "/", "2"}]}], ")"}]}], 
          "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"\[Eta]", "*", 
           RowBox[{"Cosh", "[", 
            RowBox[{"\[Eta]", "*", 
             RowBox[{"L", "/", "2"}]}], "]"}]}], ")"}]}]}], ",", 
       RowBox[{"c", "<", "x", "<", 
        RowBox[{"L", "+", "c"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "G"}], "*", "x"}], "+", 
        RowBox[{"G", "*", 
         RowBox[{"(", 
          RowBox[{"L", "+", 
           RowBox[{"2", "*", "c"}]}], ")"}]}], "-", "bL"}], ",", 
       RowBox[{"x", ">", 
        RowBox[{"L", "+", "c"}]}]}], "}"}]}], "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.0012418034528112`*^9, 4.001241808600453*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"a69aca4b-5506-46be-9814-2ef3603e1dc3"],

