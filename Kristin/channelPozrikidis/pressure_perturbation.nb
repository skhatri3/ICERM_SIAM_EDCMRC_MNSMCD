          RowBox[{"(", 
           RowBox[{"n", "*", 
            RowBox[{"Cosh", "[", 
             RowBox[{"n", "*", 
              RowBox[{"l", "/", "2"}]}], "]"}]}], ")"}]}]}], ",", 
