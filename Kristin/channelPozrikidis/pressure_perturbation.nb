Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"\[Eta]", ",", "xm", ",", "G", ",", "bL", ",", "c", ",", "L"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pExactAnon", "[", "x_", "]"}], " ", "=", " ", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "G"}], "*", "x"}], "+", "bL"}], ",", " ", 
       RowBox[{"x", "<", "c"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "G"}], "*", 
        RowBox[{
         RowBox[{"Sinh", "[", 
          RowBox[{"\[Eta]", "*", 
           RowBox[{"(", 
            RowBox[{"x", "-", "xm"}], ")"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"\[Eta]", "*", 
           RowBox[{"Cosh", "[", 
            RowBox[{"\[Eta]", "*", 
             RowBox[{"L", "/", "2"}]}], "]"}]}], ")"}]}]}], ",", 
       RowBox[{"c", "<", "x", "<", 
        RowBox[{"L", "+", "c"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
